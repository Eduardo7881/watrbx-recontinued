# Main Information
APP_NAME="ROBLOX"
APP_DESC="User-generated MMO gaming site for kids, teens, and adults. Players architect their own worlds. Builders create free online games that simulate the real world. Create and play amazing 3D games. An online gaming cloud and distributed physics engine."
APP_ENV=local
APP_DEBUG=true
BASE_URL="http://localhost:8080"

# E-mail Information to verify players.
MAIL_USER=""
MAIL_PASS=""

# Some APIs you might need to make.
# The ROBLOSECURITY can be a _ROBLOSECURITY token for any account, so we can download and use ROBLOX's assets instead of ours. You can make a alt account for it.
TurnStileKey=""
ROBLOSECURITY=""

# Maintenance Stuff
MAINTENANCE=false
ACTUAL_MAINTENANCE=false

# Stuff that players do
CAN_PURCHASE=true
CAN_REGISTER=true
CAN_LOGIN=true

# Discord Integration
DISCORD_BOT_AUTH=""
internalwebhook=""

# Asteroid Container to store assets, places, etc. (does not store database)
CONTAINERURL=""
CONTAINERPORT=""
CONTAINERADMINKEY=""

# Database Information (host, name, user and password)
DB_HOST=""
DB_NAME=""
DB_USER=""
DB_PASS=""

# RCCService for Web Things like avatar renders
WEBRCC_IP="127.0.0.1"
WEBRCC_PORT="64989"
WEBRCC_URL="roblox.com"


